{
  "compilerOptions": {
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "index.ts",
    "tailwind.config.ts",
    "tailwind.preset.ts",
    "tailwind-theme.ts"
  ]
}
