{
  "name": "ui-web",
  "private": "true",
  "version": "1.0.0",
  "description": "The web specific UI component library",
  "keywords": [
    "web",
    "UI",
    "library"
  ],
  "homepage": "https://github.com/githiomi/sb-ui#readme",
  "bugs": {
    "url": "https://github.com/githiomi/sb-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githiomi/sb-ui.git"
  },
  "license": "ISC",
  "author": "danielgithiomi <https://github.com/danielgithiomi>",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "tailwind.config.ts",
    "tailwind.preset.ts",
    "tailwind-theme.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind.preset.ts"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:styles": "bun ./scripts/build-styles.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@uniicy/assets": "workspace:*",
    "@uniicy/icons": "workspace:*",
    "@uniicy/libs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "motion": "^12.40.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.17"
  },
  "packageManager": "bun@1.3.14"
}
