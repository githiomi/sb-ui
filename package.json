{
    "name": "@uniicy/sb-ui",
    "version": "1.0.0",
    "description": "A UI component library for the web and mobile UI components used in the Sports Betting Application",
    "keywords": [
        "UI",
        "atomic",
        "components",
        "web",
        "mobile"
    ],
    "workspaces": [
        "apps/*",
        "packages/*",
        "components/*"
    ],
    "homepage": "https://github.com/githiomi/sb-ui#readme",
    "bugs": {
        "url": "https://github.com/githiomi/sb-ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/githiomi/sb-ui.git"
    },
    "license": "ISC",
    "type": "module",
    "author": "danielgithiomi <https://github.com/danielgithiomi>",
    "scripts": {
        "build": "turbo build",
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "turbo build --filter=@dgithiomi/sbui-web --filter=@uniicy/icons && turbo dev"
    },
    "devDependencies": {
        "@types/node": "^25.7.0",
        "tsup": "^8.5.1",
        "turbo": "^2.9.12",
        "typescript": "^6.0.3"
    },
    "packageManager": "bun@1.3.14"
}